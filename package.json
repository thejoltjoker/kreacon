{
	"name": "kreacon",
	"version": "0.2.39",
	"private": true,
	"scripts": {
		"postinstall": "node -e \"if (process.env.SKIP_PLAYWRIGHT_INSTALL !== '1') { require('child_process').execSync('npx playwright install --with-deps chromium', { stdio: 'inherit' }); }\"",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"commitlint": "commitlint --edit",
		"db:dbml": "tsx src/lib/server/db/dbml.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "cross-env DB_MIGRATING=true tsx src/lib/server/db/migrate.ts",
		"db:migrate:prod": "dotenv -e .env.production -- cross-env DB_MIGRATING=true tsx src/lib/server/db/migrate.ts",
		"db:push": "drizzle-kit push",
		"db:reset": "npm run db:migrate && npm run db:seed",
		"db:seed": "cross-env DB_SEEDING=true tsx src/lib/server/db/seed.ts",
		"db:start": "docker compose up",
		"db:studio": "drizzle-kit studio",
		"format": "prettier --write .",
		"lint:fix": "eslint . --fix && prettier --write .",
		"lint": "eslint . && prettier --check .",
		"logbook": "sh logbook.sh ../fsu23d-exjobb-loggbok-thejoltjoker/LOGBOOK.md",
		"prepare": "husky",
		"swa:build": "swa build",
		"swa:deploy": "swa deploy",
		"swa:start": "swa start",
		"test:e2e": "cross-env NODE_ENV=test npm run db:reset && playwright test",
		"test:e2e:ui": "cross-env NODE_ENV=test npm run db:reset && playwright test --ui",
		"test:unit": "cross-env NODE_ENV=test vitest",
		"test": "cross-env NODE_ENV=test npm run db:reset && npm run test:unit -- --run && npm run test:e2e",
		"i18n:translate": "tsx src/lib/i18n/translate.ts",
		"i18n:check": "tsx src/lib/i18n/check.ts",
		"setup:azure": "tsx src/lib/helpers/createContainers.ts"
	},
	"dependencies": {
		"@azure/communication-email": "^1.1.0",
		"@azure/identity": "^4.14.0",
		"@azure/storage-blob": "^12.34.0",
		"@bitmovin/api-sdk": "^1.284.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.57.0",
		"@microsoft/applicationinsights-web": "^3.4.5",
		"@node-rs/xxhash": "^1.7.8",
		"@playwright/test": "^1.64.1",
		"@sentry/sveltekit": "^11.7.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@types/qrcode": "^1.5.6",
		"argon2": "^0.45.1",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"dotenv": "^18.0.7",
		"dotenv-expand": "^12.0.3",
		"drizzle-orm": "^0.45.4",
		"drizzle-zod": "^0.8.3",
		"file-type": "^22.1.1",
		"http-status-codes": "^2.3.0",
		"lodash": "^4.18.1",
		"media-chrome": "^4.19.3",
		"mime": "^4.1.1",
		"object.groupby": "^1.0.3",
		"pg": "^8.23.1",
		"postgres": "^3.4.9",
		"qrcode": "^1.5.4",
		"sharp": "^0.35.5",
		"svelte": "^5.57.2",
		"svelte-i18n": "^4.0.1",
		"sveltekit-superforms": "^3.0.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"throttle-debounce": "^5.0.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@sveltejs/vite-plugin-svelte-inspector": "^5.0.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/eslint": "^9.6.1",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/lodash": "^4.17.26",
		"@types/node": "^26.6.5",
		"@types/object.groupby": "^1.0.4",
		"@types/pg": "^8.23.1",
		"@types/throttle-debounce": "^5.0.2",
		"autoprefixer": "^10.6.1",
		"cross-env": "^10.1.0",
		"dotenv-cli": "^11.0.0",
		"drizzle-dbml-generator": "^0.10.0",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"eslint-plugin-unused-imports": "^4.4.1",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"mdsvex": "^0.12.8",
		"ollama": "^0.6.4",
		"postcss-nesting": "^14.0.3",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tailwindcss-animate": "^1.0.7",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.4"
	},
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"optionalDependencies": {
		"@rollup/rollup-linux-x64-gnu": "^4.64.6"
	},
	"overrides": {
		"@sveltejs/vite-plugin-svelte-inspector": "^5.0.2"
	},
	"allowScripts": {
		"argon2@0.45.1": true,
		"esbuild@0.18.20": true,
		"esbuild@0.25.12": true,
		"esbuild@0.19.12": true,
		"esbuild@0.28.2": true,
		"esbuild@0.27.2": true,
		"@sentry/cli@2.58.6": true
	},
	"imports": {
		"#*": "./src/*",
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	}
}
